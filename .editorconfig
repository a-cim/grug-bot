root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

# Culture-aware string comparison ignores characters such as the zero-width space that mention
# neutralising relies on, so string comparisons must be ordinal (or say which culture they mean).
# CA1310: culture-specific comparison without a StringComparison; CA1309: prefer ordinal.
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
