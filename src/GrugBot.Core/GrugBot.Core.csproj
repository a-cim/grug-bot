<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VS-free library: formatting, escaping, batching and config logic live here so they can be
    unit-tested without a game server (ADR 0001). Never add a Vintage Story reference to this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GrugBot.Core</RootNamespace>
    <AssemblyName>GrugBot.Core</AssemblyName>
  </PropertyGroup>

  <!--
    Standard emoji names (decision #47), generated from gemoji by tools/generate-emoji-names.py. Embedded, so the
    mod zip gains no extra file; StandardEmoji reads it by this name.
  -->
  <ItemGroup>
    <!-- The tests read the emoji table through an internal seam (EmojiTable), to check a bad table fails safe. -->
    <InternalsVisibleTo Include="GrugBot.Core.Tests" />
    <EmbeddedResource Include="Formatting/EmojiNames.tsv" LogicalName="GrugBot.Core.Formatting.EmojiNames.tsv" />
  </ItemGroup>

</Project>
